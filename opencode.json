{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/gpt-6-luna",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "orchestrator",
  "share": "disabled",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current *", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },

    { "action": "shell", "resource": "git push*--force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git push +*", "effect": "deny" },
    { "action": "shell", "resource": "git push * +*", "effect": "deny" },
    { "action": "shell", "resource": "git push*--delete*", "effect": "deny" },
    { "action": "shell", "resource": "git push -d?*", "effect": "deny" },
    { "action": "shell", "resource": "git push -d", "effect": "deny" },
    { "action": "shell", "resource": "git push * -d*", "effect": "deny" },
    { "action": "shell", "resource": "git push :*", "effect": "deny" },
    { "action": "shell", "resource": "git push * :*", "effect": "deny" },
    { "action": "shell", "resource": "git push*--mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git push*--prune*", "effect": "deny" },

    { "action": "shell", "resource": "git -C *push*--force*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push +*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push * +*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push -d", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push -d?*", "effect": "deny" },
    { "action": "shell", "resource": "git -C * push * -d*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *push*--delete*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *push*--mirror*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *push*--prune*", "effect": "deny" },

    { "action": "shell", "resource": "git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git branch*--force*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -f*", "effect": "deny" },
    { "action": "shell", "resource": "git branch -df*", "effect": "deny" },
    { "action": "shell", "resource": "git branch * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git branch * -df*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *branch*--force*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *branch -f*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *branch -df*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *branch * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *branch * -df*", "effect": "deny" },

    { "action": "shell", "resource": "git worktree remove*--force*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree remove -f*", "effect": "deny" },
    { "action": "shell", "resource": "git worktree remove * -f*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *worktree remove*--force*", "effect": "deny" },
    { "action": "shell", "resource": "git -C *worktree remove* -f*", "effect": "deny" }
  ]
}
